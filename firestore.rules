rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE PRIMITIVES & HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION BLUEPRINTS ---

    function isValidUser(data) {
      return (('id' in data && data.id is string) || ('uid' in data && data.uid is string))
        && data.email is string && data.email.size() <= 200
        && (!('uploadsRemaining' in data) || (data.uploadsRemaining is number && data.uploadsRemaining >= 0))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 128))
        && (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 128))
        && (!('role' in data) || data.role in ['Owner', 'Admin', 'Editor', 'Viewer'])
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000000))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000000))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200))
        && (!('name' in data) || (data.name is string && data.name.size() <= 200));
    }

    function isValidCSVFile(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 255
        && data.size is int && data.size >= 0 && data.size <= 26214400
        && data.uploadedAt is string
        && data.status in ['pending', 'auditing', 'completed', 'failed']
        && data.score is int && data.score >= 0 && data.score <= 100
        && data.headers is list
        && data.rows is list
        && data.ownerId is string
        && data.issues is list
        && data.keys().hasAll(['id', 'name', 'size', 'uploadedAt', 'status', 'score', 'headers', 'rows', 'ownerId', 'issues']);
    }

    function isValidAuditActivity(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 200
        && data.action is string && data.action.size() <= 1000
        && data.timestamp is string
        && data.keys().hasAll(['id', 'userId', 'userName', 'action', 'timestamp']);
    }

    function isValidTeamMember(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.email is string && data.email.size() <= 200
        && data.role in ['Owner', 'Admin', 'Editor', 'Viewer']
        && (data.status in ['active', 'invited', 'denied'])
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000000))
        && data.keys().hasAll(['id', 'name', 'email', 'role', 'status']);
    }

    function isValidDraft(data) {
      return data.userId is string && data.userId.size() <= 128;
    }

    function isValidOrganization(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.subscriptionPlan is string
        && data.status in ['active', 'suspended', 'trial', 'past_due', 'canceled']
        && data.createdAt is string
        && data.updatedAt is string
        && data.keys().hasAll(['id', 'name', 'ownerId', 'subscriptionPlan', 'status', 'createdAt', 'updatedAt']);
    }

    function isValidOrgMember(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.organizationId is string && data.organizationId.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() <= 200
        && data.role in ['Owner', 'Admin', 'Member']
        && (!('permissions' in data) || data.permissions is list)
        && data.status in ['active', 'invited', 'suspended']
        && data.joinedAt is string
        && data.lastActive is string
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000000))
        && data.keys().hasAll(['uid', 'organizationId', 'email', 'displayName', 'role', 'status', 'joinedAt', 'lastActive']);
    }

    function isValidOrgAuditLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.organizationId is string && data.organizationId.size() <= 128
        && data.action is string && data.action.size() <= 100
        && data.actor is map
        && data.timestamp is string
        && data.keys().hasAll(['id', 'organizationId', 'action', 'actor', 'timestamp']);
    }

    function isValidOrgInvitation(data) {
      return data.id is string && data.id.size() <= 128
        && data.organizationId is string && data.organizationId.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.role in ['Admin', 'Member']
        && data.status in ['pending', 'accepted', 'cancelled', 'expired']
        && data.invitedBy is string && data.invitedBy.size() <= 128
        && data.invitedByEmail is string && data.invitedByEmail.size() <= 200
        && (!('invitedByName' in data) || (data.invitedByName is string && data.invitedByName.size() <= 200))
        && (!('organizationName' in data) || (data.organizationName is string && data.organizationName.size() <= 200))
        && data.token is string && data.token.size() <= 128
        && data.createdAt is string
        && data.expiresAt is string
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128))
        && data.keys().hasAll(['id', 'organizationId', 'email', 'role', 'status', 'invitedBy', 'invitedByEmail', 'token', 'createdAt', 'expiresAt']);
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
          (request.auth.token.email != null && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerEmail == request.auth.token.email)
        ))
      );
    }

    function isOrgAdminOrOwner(orgId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/organizations/$(orgId)) && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
          (request.auth.token.email != null && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerEmail == request.auth.token.email)
        )) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['Owner', 'Admin'])
      );
    }

    // --- COLLECTION MATCH BLOCKS ---

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn() || userId == 'usr-nyikuli';
      allow list: if isSignedIn();
      allow create: if (isSignedIn() && (request.auth.uid == userId || userId == 'usr-nyikuli')) || userId == 'usr-nyikuli';
      allow update: if (isSignedIn() && (request.auth.uid == userId || userId == 'usr-nyikuli')) || userId == 'usr-nyikuli';
      allow delete: if false;
    }

    // FILES COLLECTION
    match /files/{fileId} {
      allow get: if isSignedIn() && isValidId(fileId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(fileId) && isOwner(incoming().ownerId) && isValidCSVFile(incoming());
      allow update: if isSignedIn() && isValidId(fileId) && isOwner(existing().ownerId) && isValidCSVFile(incoming())
        && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(fileId) && isOwner(existing().ownerId);
    }

    // ACTIVITIES TIMELINE
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(activityId) && isValidAuditActivity(incoming());
      allow update, delete: if false; // Timeline is immutable append-only ledger
    }

    // ENTERPRISE ORGANIZATIONS COLLECTION & MEMBERS (Phase 1)
    match /organizations/{orgId} {
      allow get: if isSignedIn() && (isOwner(resource.data.ownerId) || isOrgMember(orgId) || request.auth.token.email == resource.data.ownerEmail);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orgId) && isOwner(incoming().ownerId) && isValidOrganization(incoming());
      // Prevent members from modifying organization ownership; only Owners/Admins may update org details
      allow update: if isSignedIn() && isValidId(orgId) && isOrgAdminOrOwner(orgId)
        && incoming().ownerId == existing().ownerId
        && isValidOrganization(incoming());
      allow delete: if isSignedIn() && isValidId(orgId) && isOwner(existing().ownerId);

      // Subcollection: Organization Members (UID as primary key)
      match /members/{memberUid} {
        allow get, list: if isSignedIn();
        // Allow Owners/Admins to create members, or the accepting user to create/join their own membership record
        allow create: if isSignedIn() && isValidId(memberUid) 
          && (isOrgAdminOrOwner(orgId) || request.auth.uid == memberUid || (request.auth.token.email != null && request.auth.token.email == incoming().email))
          && isValidOrgMember(incoming());
        allow update: if isSignedIn() && isValidId(memberUid) 
          && (isOrgAdminOrOwner(orgId) || (request.auth.uid == memberUid && incoming().diff(existing()).affectedKeys().hasOnly(['lastActive', 'avatar', 'displayName'])))
          && isValidOrgMember(incoming());
        allow delete: if isSignedIn() && isValidId(memberUid) && isOrgAdminOrOwner(orgId);
      }

      // Subcollection: Organization Invitations (Phase 2)
      match /invitations/{invitationId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(invitationId) && isValidOrgInvitation(incoming());
        allow update: if isSignedIn() && isValidId(invitationId);
        allow delete: if isSignedIn() && isValidId(invitationId);
      }

      // Subcollection: Organization Immutable Audit Logs (Phase 3)
      match /audit_logs/{logId} {
        // Only Owners and Admins may read/list organization audit logs
        allow get, list: if isSignedIn() && isOrgAdminOrOwner(orgId);
        // Any signed-in user or active organization member may append new audit log records
        allow create: if isSignedIn() && isValidId(logId) && isValidOrgAuditLog(incoming());
        // Audit logs are strictly immutable: no updates or deletions allowed
        allow update, delete: if false;
      }
    }

    // MEMBERS COLLECTION (Legacy / top-level compatibility)
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(memberId) && isValidTeamMember(incoming());
      allow delete: if isSignedIn() && isValidId(memberId);
    }

    // INVITATIONS COLLECTION (Top-level compatibility)
    match /invitations/{invitationId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // DRAFTS COLLECTION
    match /drafts/{userId} {
      allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // SLOT REQUESTS COLLECTION
    match /slot_requests/{reqId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // CHAT MESSAGES COLLECTION
    match /chat_messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // ANNOTATIONS COLLECTION (Top-level)
    match /annotations/{annotationId} {
      allow read, create, update, delete: if true;
    }

    // MULTI-TENANT WORKSPACE ANNOTATIONS & CHAT
    match /tenants/{tenantId}/workspaces/{workspaceId}/annotations/{annotationId}/messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // MULTI-TENANT WORKSPACE PRESENCE
    match /tenants/{tenantId}/workspaces/{workspaceId}/presence/{userId} {
      allow read, create, update, delete: if true;
    }

    // MULTI-TENANT WORKSPACE TYPING INDICATORS
    match /tenants/{tenantId}/workspaces/{workspaceId}/typing/{userId} {
      allow read, create, update, delete: if true;
    }
  }
}
