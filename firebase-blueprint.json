{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role details and account metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique auth UID of the user."
        },
        "name": {
          "type": "string",
          "description": "Full display name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user."
        },
        "uploadsRemaining": {
          "type": "number",
          "description": "Remaining freemium CSV audit uploads for multi-device synchronization."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating last quota change or profile update."
        },
        "role": {
          "type": "string",
          "enum": ["Owner", "Admin", "Editor", "Viewer"],
          "description": "SaaS authorization tier."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating registration date."
        }
      },
      "required": ["id", "email"]
    },
    "CSVFile": {
      "title": "CSVFile",
      "description": "Audit file details including headers, data rows, and flagged compliance issues.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "uploadedAt": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "auditing", "completed", "failed"]
        },
        "score": {
          "type": "number"
        },
        "headers": {
          "type": "array"
        },
        "rows": {
          "type": "array"
        },
        "cleanedRows": {
          "type": "array"
        },
        "ownerId": {
          "type": "string"
        },
        "issues": {
          "type": "array"
        }
      },
      "required": ["id", "name", "size", "uploadedAt", "status", "score", "headers", "rows", "ownerId", "issues"]
    },
    "AuditActivity": {
      "title": "AuditActivity",
      "description": "A single entry in the tenant workspace real-time activity timeline feed.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "userName": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        }
      },
      "required": ["id", "userId", "userName", "action", "timestamp"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "A colleague or invited tenancy collaborator.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["Owner", "Admin", "Editor", "Viewer"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "invited"]
        }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "DraftUploadState": {
      "title": "DraftUploadState",
      "description": "In-progress CSV upload and mapping configuration drafts.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "pendingFile": {
          "type": "object"
        },
        "mappings": {
          "type": "object"
        },
        "explanations": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["userId", "mappings", "explanations", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time Cell Annotation Board multi-tenant chat message.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "messageId": { "type": "string" },
        "tenantId": { "type": "string" },
        "workspaceId": { "type": "string" },
        "annotationId": { "type": "string" },
        "fileId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "senderRole": { "type": "string" },
        "text": { "type": "string" },
        "cellRef": { "type": "string" },
        "mentions": { "type": "array" },
        "attachments": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "edited": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "status": { "type": "string" }
      },
      "required": ["id", "tenantId", "workspaceId", "annotationId", "senderEmail", "text", "createdAt"]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time user online presence heartbeat.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "status": { "type": "string" },
        "lastActive": { "type": "number" }
      },
      "required": ["userId", "userEmail", "status", "lastActive"]
    },
    "TypingIndicator": {
      "title": "TypingIndicator",
      "description": "Real-time chat typing indicator state.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "userName", "timestamp"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Enterprise organization workspace definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "subscriptionPlan": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "maxSeats": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "ownerId", "subscriptionPlan", "status", "createdAt", "updatedAt"]
    },
    "OrganizationMember": {
      "title": "OrganizationMember",
      "description": "Enterprise workspace member with role and granular permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "organizationId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "permissions": { "type": "array" },
        "status": { "type": "string" },
        "joinedAt": { "type": "string" },
        "lastActive": { "type": "string" },
        "avatar": { "type": "string" }
      },
      "required": ["uid", "organizationId", "email", "displayName", "role", "status", "joinedAt", "lastActive"]
    },
    "OrganizationInvitation": {
      "title": "OrganizationInvitation",
      "description": "Enterprise workspace member invitation token.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "invitedBy": { "type": "string" },
        "invitedByEmail": { "type": "string" },
        "token": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "email", "role", "status", "invitedBy", "invitedByEmail", "token", "createdAt", "expiresAt"]
    },
    "OrganizationAuditLog": {
      "title": "OrganizationAuditLog",
      "description": "Immutable audit log entry of actions within the enterprise workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "action": { "type": "string" },
        "actor": { "type": "object" },
        "target": { "type": "object" },
        "timestamp": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "organizationId", "action", "actor", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User specific configuration profiles and tenancy roles."
    },
    "/files/{fileId}": {
      "schema": "CSVFile",
      "description": "A ledger of audited spreadsheets with row and issue tracking."
    },
    "/activities/{activityId}": {
      "schema": "AuditActivity",
      "description": "Real-time ledger of actions executed across the workspace."
    },
    "/members/{memberId}": {
      "schema": "TeamMember",
      "description": "Shared list of invited colleagues in the tenancy segment."
    },
    "/drafts/{userId}": {
      "schema": "DraftUploadState",
      "description": "Auto-saved in-progress upload state and mappings."
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Root document for enterprise organization workspaces."
    },
    "/organizations/{orgId}/members/{memberUid}": {
      "schema": "OrganizationMember",
      "description": "Organization membership document indexed by user Firebase UID."
    },
    "/organizations/{orgId}/invitations/{invitationId}": {
      "schema": "OrganizationInvitation",
      "description": "Pending, accepted, or expired organization invitations."
    },
    "/organizations/{orgId}/audit_logs/{logId}": {
      "schema": "OrganizationAuditLog",
      "description": "Immutable organization audit log entries."
    },
    "/tenants/{tenantId}/workspaces/{workspaceId}/annotations/{annotationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Multi-tenant team chat messages for cell annotations."
    },
    "/tenants/{tenantId}/workspaces/{workspaceId}/presence/{userId}": {
      "schema": "UserPresence",
      "description": "Team workspace member live presence status."
    },
    "/tenants/{tenantId}/workspaces/{workspaceId}/typing/{userId}": {
      "schema": "TypingIndicator",
      "description": "Real-time user typing indicators."
    },
    "/annotations/{annotationId}": {
      "schema": "ChatMessage",
      "description": "Root annotations path for legacy and top-level sync."
    }
  }
}
